# TaskMate Backend Environment Configuration (.env.example)
# Rename this file to .env and configure your local or cloud MongoDB URI and JWT Secret

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Local: mongodb://127.0.0.1:27017/taskmate
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskmate?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/taskmate

# Secret key used to sign and verify JSON Web Tokens (JWT)
# In production, use a long, cryptographically random string
JWT_SECRET=taskmate_super_secret_jwt_key_2026_student_manager

# Token expiration period (e.g. 30d for 30 days)
JWT_EXPIRE=30d
